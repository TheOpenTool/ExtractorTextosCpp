{
  "archivo_textos": "src/Localizacion/Textos.inc",
  "cabecera": "src/Localizacion/Localizacion.h",
  "declaracion": "using Localizacion::Texto;",
  "calificador_cabeceras": "Localizacion::",
  "tipo_texto": "Texto",
  "minimo_letras": 2,
  "max_palabras_nombre": 5,
  "ancho_codigo": 120,
  "excluir": ["^[XYZWxyzw]:?$", "^(RGB|RGBA|HDR|FPS|ID|UV|URL|OK)$", "^[^ ]+ \\(\\.[a-z]+\\)$"],
  "textos": {
    "prefijo_entrada": "TEXTO",
    "inicio_bloque": "^#if TEXTOS_BLOQUE < 0 \\|\\| TEXTOS_BLOQUE == (\\d+)",
    "fin_bloque": "^#endif",
    "ancho_maximo": 100
  },
  "plantillas": {
    "texto": "Localizacion::tr(Texto::{nombre})",
    "formato": "Localizacion::tr(Texto::{nombre})",
    "formato_sin_argumentos": "\"%s\", Localizacion::tr(Texto::{nombre})",
    "etiqueta": "Localizacion::etiqueta(Texto::{nombre}).c_str()",
    "etiqueta_con_sufijo": "Localizacion::etiqueta(Texto::{nombre}, \"{sufijo}\").c_str()",
    "titulo_con_id": "Localizacion::etiqueta(Texto::{nombre}, \"###{original}\").c_str()",
    "id": "\"###{original}\""
  },
  "funciones": {
    "ImGui::Text": {"tipo": "formato"},
    "ImGui::TextDisabled": {"tipo": "formato"},
    "ImGui::TextWrapped": {"tipo": "formato"},
    "ImGui::BulletText": {"tipo": "formato"},
    "ImGui::SetTooltip": {"tipo": "formato"},
    "ImGui::TextColored": {"tipo": "formato", "arg": 1},
    "ImGui::TextUnformatted": {"tipo": "texto"},
    "ImGui::SeparatorText": {"tipo": "texto"},
    "ImGui::Button": {"tipo": "etiqueta"},
    "ImGui::SmallButton": {"tipo": "etiqueta"},
    "ImGui::Checkbox": {"tipo": "etiqueta"},
    "ImGui::MenuItem": {"tipo": "etiqueta"},
    "ImGui::BeginMenu": {"tipo": "etiqueta"},
    "ImGui::Selectable": {"tipo": "etiqueta"},
    "ImGui::RadioButton": {"tipo": "etiqueta"},
    "ImGui::TreeNode": {"tipo": "etiqueta"},
    "ImGui::TreeNodeEx": {"tipo": "etiqueta"},
    "ImGui::CollapsingHeader": {"tipo": "etiqueta"},
    "ImGui::BeginTabItem": {"tipo": "etiqueta"},
    "ImGui::DragFloat": {"tipo": "etiqueta"},
    "ImGui::DragFloat2": {"tipo": "etiqueta"},
    "ImGui::DragFloat3": {"tipo": "etiqueta"},
    "ImGui::DragFloat4": {"tipo": "etiqueta"},
    "ImGui::DragInt": {"tipo": "etiqueta"},
    "ImGui::DragScalar": {"tipo": "etiqueta"},
    "ImGui::SliderFloat": {"tipo": "etiqueta"},
    "ImGui::SliderInt": {"tipo": "etiqueta"},
    "ImGui::InputText": {"tipo": "etiqueta"},
    "ImGui::InputTextMultiline": {"tipo": "etiqueta"},
    "ImGui::InputInt": {"tipo": "etiqueta"},
    "ImGui::InputFloat": {"tipo": "etiqueta"},
    "ImGui::InputFloat3": {"tipo": "etiqueta"},
    "ImGui::Combo": {"tipo": "etiqueta"},
    "ImGui::BeginCombo": {"tipo": "etiqueta"},
    "ImGui::ColorEdit3": {"tipo": "etiqueta"},
    "ImGui::ColorEdit4": {"tipo": "etiqueta"},
    "ImGui::BeginPopupModal": {"tipo": "titulo_con_id"},
    "ImGui::OpenPopup": {"tipo": "id"},
    "ImGui::IsPopupOpen": {"tipo": "id"}
  }
}
